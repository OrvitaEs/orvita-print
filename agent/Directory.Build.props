<Project>
  <!-- ADR-10/ADR-12: net10.0, nullable, x64 documentado para publicación self-contained posterior. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orvita.Print</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Versión ÚNICA de todos los proyectos del agente (F2-11): la reporta el heartbeat,
         status y doctor (InformationalVersion), y la compara el canal de actualización. Los
         sufijos «-dev» se recortan al comparar; F3 ajusta el número en cada release. -->
    <Version>1.0.0-dev</Version>
  </PropertyGroup>
</Project>
