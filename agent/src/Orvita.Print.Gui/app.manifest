<?xml version="1.0" encoding="utf-8"?>
<assembly manifestType="custom" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Orvita.Print.Gui.app" />

  <!-- Compatibilidad con Windows 10/11 (Doc/03 §13). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd4a36a348}" />
    </application>
  </compatibility>

  <!-- DPI por monitor (tickets legibles en pantallas escaladas del TPV). -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
