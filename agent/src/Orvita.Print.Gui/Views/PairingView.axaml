<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orvita.Print.Gui.ViewModels"
        xmlns:v="using:Orvita.Print.Gui.Views"
        x:Class="Orvita.Print.Gui.Views.PairingView"
        x:DataType="vm:PairingViewModel">
  <!-- GUI-11 (responsive): MaxWidth 720 y centrado en el área (Stretch + MaxWidth). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid MaxWidth="720" RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Cabecera (GUI-09): tile azul con icono de tienda. -->
      <v:PageHeader Grid.Row="0" Icon="{StaticResource Icon.Store}"
                    Title="Emparejamiento"
                    Subtitle="Estado de la conexión con la tienda"/>

      <!-- Estado actual: verde si emparejado, ámbar si falta algo. El ServerUrl es visible;
           el token OCULTO SIEMPRE (S-05: no viaja por la pipe ni se muestra). -->
      <Border Grid.Row="1" Classes="status-ok" IsVisible="{Binding Paired}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Path Data="{StaticResource Icon.CheckCircle}" Width="26" Height="26"
                Stretch="Uniform" Fill="{StaticResource App.Green.Brush}" VerticalAlignment="Top"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Estado del emparejamiento" FontWeight="Bold" Foreground="#1B5E20"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#1B5E20"/>
            <TextBlock Classes="hint" Opacity="0.8" Foreground="#1B5E20"
                       Text="El token de acceso se guarda CIFRADO en el equipo (DPAPI) y jamás se muestra en pantalla."/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Classes="status-warn" IsVisible="{Binding !Paired}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Path Data="{StaticResource Icon.Warning}" Width="26" Height="26"
                Stretch="Uniform" Fill="{StaticResource App.Amber.Brush}" VerticalAlignment="Top"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Estado del emparejamiento" FontWeight="Bold" Foreground="{StaticResource App.Amber.Brush}"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource App.Amber.Brush}"/>
            <TextBlock Classes="hint" Opacity="0.8"
                       Text="El token de acceso se guarda CIFRADO en el equipo (DPAPI) y jamás se muestra en pantalla."/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Flujo: pegar la URL + el código de 6 dígitos → pair → confirmación con el local. -->
      <Border Grid.Row="2" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="card-title" Text="Emparejar con la tienda"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource App.Primary.Brush}">
              <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="En el panel de Orvita Print (WordPress), genera un código de emparejamiento."
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource App.Primary.Brush}">
              <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Pega aquí la URL de tu tienda y el código de 6 dígitos:"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <!-- GUI-11: controles de 32 px (App.axaml) y URL alineada con el código. -->
          <TextBox Text="{Binding ServerUrlInput}" Watermark="https://tu-tienda.es/wp-json/orp-print/v1"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding CodeInput}" Watermark="482913" MaxLength="6" Width="140"/>
            <Button Classes="primary" Click="OnPairClick" IsEnabled="{Binding !IsBusy}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource Icon.Link}" Width="15" Height="15" Stretch="Uniform" Fill="White"/>
                <TextBlock Text="Emparejar"/>
              </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="90" Height="6" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
          </StackPanel>
          <CheckBox Content="Permitir HTTP sin cifrar (SOLO desarrollo, p. ej. wp-env)"
                    IsChecked="{Binding AllowInsecureHttp}"/>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                     Foreground="{Binding IsError, Converter={x:Static v:BoolToBrushConverter.Instance}}"/>
        </StackPanel>
      </Border>

      <!-- Desemparejar: doble confirmación en la vista; usa pair.remove. Queda como paso
           del administrador revocar (o confirmar la baja) desde el panel. -->
      <Border Grid.Row="3" Classes="status-danger">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="{StaticResource Icon.Warning}" Width="22" Height="22"
                  Stretch="Uniform" Fill="{StaticResource App.Amber.Brush}" VerticalAlignment="Center"/>
            <TextBlock Text="Desemparejar" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource App.Navy.Brush}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Classes="hint"
                     Text="El agente deja de recibir pedidos y borra URL, token y local de este equipo. El administrador deberá revocar (o confirmar la baja) desde el panel."/>
          <Button Classes="danger" Click="OnUnpairClick" IsEnabled="{Binding Paired}"
                  Content="Desemparejar este equipo…" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
