<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orvita.Print.Gui.ViewModels"
        xmlns:v="using:Orvita.Print.Gui.Views"
        x:Class="Orvita.Print.Gui.Views.DestinationsView"
        x:DataType="vm:DestinationsViewModel">
  <!-- GUI-11 (responsive) / GUI-13 (fluido): Grid de filas Auto…* SIN MaxWidth; la lista de
       tarjetas crece en la fila * y el formulario queda abajo (Auto). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- Cabecera (GUI-12): tile azul con el MISMO icono que el item «Salidas» del menú
           lateral (lista — MainWindow.axaml) para que cabecera y menú coincidan. -->
      <v:PageHeader Grid.Row="0" Icon="{StaticResource Icon.List}"
                    Title="Salidas"
                    Subtitle="Impresoras y copias de este equipo">
        <v:PageHeader.Actions>
          <Button Classes="secondary" Click="OnLoadClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource Icon.Refresh}" Width="15" Height="15"
                    Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
              <TextBlock Text="Actualizar"/>
            </StackPanel>
          </Button>
        </v:PageHeader.Actions>
      </v:PageHeader>

      <!-- Aviso de impresora repetida (Doc/08 §4.3). -->
      <Border Grid.Row="1" Classes="banner-warn" IsVisible="{Binding DuplicateNote, Converter={x:Static v:NotNullConverter.Instance}}">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0" Data="{StaticResource Icon.Warning}" Width="18" Height="18"
                Stretch="Uniform" Fill="{StaticResource App.Amber.Brush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding DuplicateNote}" Foreground="{StaticResource App.Amber.Brush}"
                     VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <!-- Error de carga (sin servicio). -->
      <Border Grid.Row="2" Classes="banner-danger" IsVisible="{Binding LoadError, Converter={x:Static v:NotNullConverter.Instance}}">
        <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource App.Red.Brush}" TextWrapping="Wrap"/>
      </Border>

      <!-- Lista de salidas como TARJETAS (GUI-09): icono, rol en negrita, impresora + copias,
           badge Activa/Inactiva, casilla y botones con iconos. Mismo contrato que el CLI.
           GUI-11: la lista vive en la fila * (crece con la ventana). -->
      <ListBox Grid.Row="3" Classes="table" ItemsSource="{Binding Destinations}" x:Name="DestinationsList" Margin="0,0,0,12">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:DestinationRow">
            <Border Classes="card" Padding="14" Margin="0,0,0,10">
              <!-- GUI-11: dos zonas — info (columna *) y acciones (Auto, alineadas a la
                   derecha); 12 px de aire entre la casilla «Activar» y el botón Editar. -->
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Border Width="38" Height="38" CornerRadius="9" Background="#E8F1FB">
                    <Path Data="{StaticResource Icon.Printer}" Width="20" Height="20"
                          Stretch="Uniform" Fill="{StaticResource App.Primary.Brush}"/>
                  </Border>
                  <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="380">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Role}" FontWeight="Bold" FontSize="14"
                                 Foreground="{StaticResource App.Navy.Brush}"/>
                      <Border Classes="badge" Background="{Binding StateBadgeColor, Converter={x:Static v:HexToBrushConverter.Instance}}">
                        <TextBlock Text="{Binding StateBadgeText}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding PrinterDisplay}" FontSize="12"
                               Foreground="{StaticResource App.Gray.Brush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               Foreground="{StaticResource App.Gray.Brush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Copies, StringFormat='{}{0} copias'}" FontSize="12"
                             Foreground="{StaticResource App.Gray.Brush}" VerticalAlignment="Center"/>
                  <CheckBox Content="Activar" IsChecked="{Binding Enabled}" IsEnabled="False" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="12,0,0,0">
                  <Button Classes="secondary" Click="OnEditClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Data="{StaticResource Icon.Edit}" Width="13" Height="13"
                            Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                      <TextBlock Text="Editar"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="secondary" Click="OnRemoveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Data="{StaticResource Icon.Trash}" Width="13" Height="13"
                            Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                      <TextBlock Text="Quitar"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="secondary" Click="OnTestClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Data="{StaticResource Icon.CheckCircle}" Width="13" Height="13"
                            Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                      <TextBlock Text="Probar"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Formulario: añadir/editar salida (destination.add = upsert por role).
           GUI-11: retícula del formulario — columnas de etiqueta fijas (90 px) + campo *,
           hueco vertical de 12 px y altura única de control 32 px (App.axaml). -->
      <Border Grid.Row="4" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="card-title" Text="Añadir o editar salida (se guarda por rol)"/>
          <Grid ColumnDefinitions="90,*,90,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Rol:"/>
            <AutoCompleteBox Grid.Row="0" Grid.Column="1" Text="{Binding FormRole, Mode=TwoWay}"
                             ItemsSource="{Binding RoleSuggestions}" Watermark="default"
                             FilterMode="StartsWithOrdinal" MinimumPrefixLength="0"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="field-label" Text="Etiqueta:" Margin="12,0,6,0"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding FormLabel}" Watermark="Mostrador"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Copias:" Margin="0,12,6,0"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FormCopies}" Minimum="1" Maximum="99" Margin="0,12,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="field-label" Text="Tipo:" Margin="12,12,6,0"/>
            <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding KindOptions}"
                      SelectedValue="{Binding FormKind}"
                      SelectedValueBinding="{Binding Value}"
                      DisplayMemberBinding="{Binding Display}"
                      Margin="0,12,0,0" HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Impresora:" Margin="0,12,6,0"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Printers}"
                      SelectedItem="{Binding FormPrinter}"
                      DisplayMemberBinding="{Binding Display}"
                      IsEnabled="{Binding PrinterSelectionEnabled}"
                      Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="field-label" Text="Dirección:" Margin="12,12,6,0"/>
            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding FormAddress}"
                     Watermark="192.168.1.50:9100 o C:\PDFs" Margin="0,12,0,0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
            <CheckBox Content="Salida activa" IsChecked="{Binding FormEnabled}" VerticalAlignment="Center"/>
            <Button Classes="primary" Click="OnSaveClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource Icon.Save}" Width="14" Height="14" Stretch="Uniform" Fill="White"/>
                <TextBlock Text="Guardar salida"/>
              </StackPanel>
            </Button>
            <Button Classes="secondary" Click="OnResetClick" Content="Nuevo"/>
          </StackPanel>
          <TextBlock Text="{Binding WarningsText}" Foreground="{StaticResource App.Amber.Brush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding WarningsText, Converter={x:Static v:NotNullConverter.Instance}}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource Icon.Info}" Width="14" Height="14" Stretch="Uniform"
                  Fill="{StaticResource App.Primary.Brush}" VerticalAlignment="Top"/>
            <TextBlock Classes="hint"
                       Text="El tipo «pdf» es solo para demos — imprime el ticket a fichero con «Microsoft Print to PDF», sin impresora térmica."/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
