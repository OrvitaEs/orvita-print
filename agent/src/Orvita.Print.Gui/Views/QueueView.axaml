<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orvita.Print.Gui.ViewModels"
        xmlns:models="using:Orvita.Print.Gui.Models"
        xmlns:v="using:Orvita.Print.Gui.Views"
        x:Class="Orvita.Print.Gui.Views.QueueView"
        x:DataType="vm:QueueViewModel">
  <!-- GUI-11 (responsive) / GUI-13 (fluido): la página es un Grid de filas Auto…* dentro de
       un ScrollViewer SIN MaxWidth (anclado a izquierda/arriba/derecha): la tabla ocupa TODO
       el ancho disponible (ventana − sidebar − 24 px por lado del shell) a cualquier tamaño,
       maximizada incluida, y reparte el ancho extra entre columnas (la flexible «Último
       error» es *). Conserva los MinWidth de los controles al encoger. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,*">

      <!-- Cabecera (GUI-09): tile azul con el icono de impresora + botón Actualizar arriba
           a la derecha. El auto-refresco de 3 s NO cambia ( vive en MainWindow.axaml.cs). -->
      <v:PageHeader Grid.Row="0" Icon="{StaticResource Icon.Printer}"
                    Title="Cola de impresión"
                    Subtitle="Gestiona la cola de trabajos de impresión">
        <v:PageHeader.Actions>
          <Button Classes="secondary" Click="OnRefreshClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource Icon.Refresh}" Width="15" Height="15"
                    Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
              <TextBlock Text="Actualizar"/>
            </StackPanel>
          </Button>
        </v:PageHeader.Actions>
      </v:PageHeader>

      <!-- Aviso de errores no vistos (persistente hasta que el usuario los abra, Doc/08 §4.2):
           banner rojo con triángulo-aviso y «Marcar vistos» con borde rojo. -->
      <Border Grid.Row="1" Classes="banner-danger" IsVisible="{Binding BannerVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Path Grid.Column="0" Data="{StaticResource Icon.Warning}" Width="18" Height="18"
                Stretch="Uniform" Fill="{StaticResource App.Red.Brush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding BannerText}" Foreground="{StaticResource App.Red.Brush}"
                     FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0" TextWrapping="Wrap"/>
          <Button Grid.Column="2" Classes="danger" Command="{Binding MarkAllSeenCommand}" Content="Marcar vistos"/>
        </Grid>
      </Border>

      <!-- Filtro por estado + búsqueda por nº de trabajo (Doc/08 §4.2). -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <TextBlock Text="Estado:" VerticalAlignment="Center" FontSize="12"
                   Foreground="{StaticResource App.Navy.Brush}"/>
        <ComboBox ItemsSource="{Binding StateFilterOptions}"
                  SelectedValue="{Binding StateFilter}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Display}"
                  MinWidth="170"/>
        <TextBox Text="{Binding SearchText}" Watermark="Buscar por nº de trabajo…" MinWidth="190"/>
        <Button Classes="secondary" Click="OnRefreshClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource Icon.Refresh}" Width="14" Height="14"
                  Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
            <TextBlock Text="Actualizar"/>
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding LastRefreshText}" VerticalAlignment="Center" FontSize="12"
                   Foreground="{StaticResource App.Gray.Brush}"/>
      </StackPanel>

      <!-- Fila *: la tabla de trabajos (con sus cabeceras) crece hasta el alto disponible;
           debajo, el panel de detalle (cuando hay un trabajo seleccionado) y el estado vacío
           (cuando no hay filas, la tarjeta llena el hueco con su mensaje centrado). -->
      <Grid Grid.Row="3" RowDefinitions="*,Auto">
        <Border Grid.Row="0" Classes="card" Padding="0,4,0,4" Margin="0,0,0,12"
                IsVisible="{Binding !ShowEmptyState}">
          <Grid RowDefinitions="Auto,*">
            <!-- GUI-16: anchos medidos (sondeo headless) para que TODA la tabla quepa en la
               tarjeta al ancho mínimo de ventana (720 px: fila útil ~476 px). Fijas:
               50+64+40+68+48+96+72 = 438 → «Último error» (*) queda con ~38 px incluso a
               720 y con scrollbar vertical. «Impresión» sale de la TABLA (la marca completa
               vive en el panel de detalle, DetailLines) y «Llegada» pasa a formato corto
               dd/MM HH:mm con tooltip completo (TimestampConverter). -->
          <Grid Grid.Row="0" ColumnDefinitions="50,64,40,68,48,*,96,72" Margin="14,10,14,8">
              <TextBlock Grid.Column="0" Classes="table-header" Text="Pedido"/>
              <TextBlock Grid.Column="1" Classes="table-header" Text="Salida / rol"/>
              <TextBlock Grid.Column="2" Classes="table-header" Text="Copias"/>
              <TextBlock Grid.Column="3" Classes="table-header" Text="Llegada"/>
              <TextBlock Grid.Column="4" Classes="table-header" Text="Intentos"/>
              <TextBlock Grid.Column="5" Classes="table-header" Text="Último error"/>
              <TextBlock Grid.Column="6" Classes="table-header" Text="Estado"/>
              <TextBlock Grid.Column="7" Classes="table-header" Text="Acciones"/>
            </Grid>
            <ListBox Grid.Row="1" Classes="table rows" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedJob}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:QueueJobRow">
                  <!-- GUI-13: sin margen propio — el aire vertical (7 px) y el inset
                       horizontal (14 px, igual que la cabecera) los pone el ListBoxItem
                       (App.axaml, clase «rows»); las columnas quedan alineadas con ella. -->
                  <!-- GUI-16: MISMAS definiciones de columna que la cabecera (alineado GUI-13).
                       Llegada en formato corto dd/MM HH:mm con la marca completa en el tooltip;
                       la columna «Impresión» vive solo en el panel de detalle. -->
                  <Grid ColumnDefinitions="50,64,40,68,48,*,96,72">
                    <TextBlock Grid.Column="0" Text="{Binding OrderDisplay}" Foreground="{StaticResource App.Navy.Brush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PrinterRole}" Foreground="{StaticResource App.Navy.Brush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Copies}" Foreground="{StaticResource App.Navy.Brush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding CreatedAt, Converter={x:Static v:ShortTimestampConverter.Instance}}"
                               ToolTip.Tip="{Binding CreatedAt, Converter={x:Static v:TimestampConverter.Instance}}"
                               Foreground="{StaticResource App.Gray.Brush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Attempts}" Foreground="{StaticResource App.Gray.Brush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding LastErrorDisplay}" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource App.Red.Brush}"/>
                    <Border Grid.Column="6" Classes="badge" HorizontalAlignment="Left"
                            Background="{Binding StateColor, Converter={x:Static v:HexToBrushConverter.Instance}}">
                      <TextBlock Text="{Binding StateLabel}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <!-- Acciones de fila (GUI-15) SOLO-ICONO (GUI-16): con texto no caben en la
                         columna al ancho mínimo de ventana (Reimprimir 97 + Revisar 75 + spacing
                         = 178 px); con icono son 58 px y quedan DENTRO de la tarjeta (prueba
                         headless). El sentido lo dan los tooltips; los botones con texto están
                         en el panel de detalle. «Reimprimir» en error y done; «Revisar» solo en
                         error sin revisar. -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="secondary icon-action" Click="OnRetryClick" IsVisible="{Binding ShowRetry}"
                              ToolTip.Tip="Reimprimir el ticket con el documento guardado en la cola local">
                        <Path Data="{StaticResource Icon.Refresh}" Width="12" Height="12"
                              Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                      </Button>
                      <Button Classes="secondary icon-action" Click="OnReviewClick" IsVisible="{Binding ShowReview}"
                              ToolTip.Tip="Marcar la incidencia como revisada: el TPV ya la gestionó (sale del aviso de errores)">
                        <Path Data="{StaticResource Icon.CheckCircle}" Width="12" Height="12"
                              Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- Estado vacío (GUI-09): icono de documento + texto; cuando la pipe/servidor no
             responde, el texto es el mensaje de reconexión. Ocupa la misma fila * que la
             tabla (nunca son visibles a la vez). -->
        <Border Grid.Row="0" Classes="card" Padding="28" IsVisible="{Binding ShowEmptyState}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <Path Data="{StaticResource Icon.Document}" Width="36" Height="36" Stretch="Uniform"
                  Fill="#9DB8D6" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyStateText}" HorizontalAlignment="Center"
                       Foreground="{StaticResource App.Gray.Brush}" TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Detalle del trabajo: documento legible + marcas de tiempo completas (op queue.item).
             Acciones (GUI-15) con texto (aquí SÍ hay sitio, GUI-16): Reimprimir (siempre
             disponible con trabajo seleccionado; con confirmación si ya está impreso) y
             Revisar (solo errores sin revisar; tooltip con el significado completo). -->
        <Border Grid.Row="1" Classes="card" IsVisible="{Binding HasDetail}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="secondary" Click="OnRetryClick" IsVisible="{Binding SelectedJob.ShowRetry}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource Icon.Refresh}" Width="13" Height="13"
                        Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                  <TextBlock Text="Reimprimir"/>
                </StackPanel>
              </Button>
              <Button Classes="secondary" Click="OnReviewClick" IsVisible="{Binding SelectedJob.ShowReview}"
                      ToolTip.Tip="Marcar la incidencia como revisada: el TPV ya la gestionó">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource Icon.CheckCircle}" Width="13" Height="13"
                        Stretch="Uniform" Fill="{StaticResource App.Navy.Brush}"/>
                  <TextBlock Text="Revisar"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding DetailTitle}" FontWeight="Bold"
                       Foreground="{StaticResource App.Navy.Brush}"/>
            <TextBox Text="{Binding DetailText}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="150"
                     FontFamily="Consolas, 'Cascadia Mono', monospace" FontSize="12"
                     Background="#F7FAFD" BorderBrush="{StaticResource App.Card.Border}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
