<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Set de iconos de la GUI (GUI-09): geometrías Path EMBEDIDAS en XAML — sin ficheros
    externos ni recursos remotos (regla permanente). Todos en una retícula 24x24, relleno
    sólido: se pintan con Fill="#1976D2" (sobre claro) o Fill="White" (sobre azul). Los
    "agujeros" (exclamación, check, info…) usan la regla de relleno EvenOdd de defecto.
  -->

  <!-- Impresora: bandeja superior + cuerpo con salida inferior. -->
  <StreamGeometry x:Key="Icon.Printer">M7 4h10v4H7z M3 10h18v6h-4v4H7v-4H3z</StreamGeometry>

  <!-- Lista: tres puntos + tres barras (Salidas). -->
  <StreamGeometry x:Key="Icon.List">M4 6h2.5v2.5H4z M8.5 6H20v2.5H8.5z M4 10.75h2.5v2.5H4z M8.5 10.75H20v2.5H8.5z M4 15.5h2.5V18H4z M8.5 15.5H20V18H8.5z</StreamGeometry>

  <!-- Cadena/enlace (Emparejamiento): dos eslabones + travesaño. -->
  <StreamGeometry x:Key="Icon.Link">M8 7H6.5a4.5 4.5 0 1 0 0 9H8v-2H6.5a2.5 2.5 0 1 1 0-5H8V7z M16 7h1.5a4.5 4.5 0 1 1 0 9H16v-2h1.5a2.5 2.5 0 1 0 0-5H16V7z M9.5 11h5v2h-5z</StreamGeometry>

  <!-- Pulso/onda (Diagnóstico): latido con cinta de 2 px de grosor. -->
  <StreamGeometry x:Key="Icon.Pulse">M1 14h4l2-6 4 12 3-11 2 5h7v2h-7l-2-5-3 11-4-12-2 6H1z</StreamGeometry>

  <!-- Engranaje (Configuración) — glifo estándar de 24 px con agujero central. -->
  <StreamGeometry x:Key="Icon.Gear">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</StreamGeometry>

  <!-- Info: círculo con «i» calada. -->
  <StreamGeometry x:Key="Icon.Info">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M10.6 10h2.8v7.2h-2.8z M12 5.8a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4z</StreamGeometry>

  <!-- Refrescar: flecha circular. -->
  <StreamGeometry x:Key="Icon.Refresh">M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-0.82,2.33-3.04,4-5.65,4c-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14,0.69,4.22,1.78L13,11h7V4L17.65,6.35z</StreamGeometry>

  <!-- Descarga: flecha hacia una base. -->
  <StreamGeometry x:Key="Icon.Download">M12 16l-5-6h3V3h4v7h3l-5 6z M4 18h16v3H4z</StreamGeometry>

  <!-- Carpeta abierta. -->
  <StreamGeometry x:Key="Icon.Folder">M2 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v1H2V6z M2 10h20l-2.2 8.4a1 1 0 0 1-1 .6H3a1 1 0 0 1-1-1V10z</StreamGeometry>

  <!-- Triángulo de aviso con exclamación calada. -->
  <StreamGeometry x:Key="Icon.Warning">M12 3L1.5 21h21L12 3z M12 9.5a1.3 1.3 0 0 1 1.3 1.4l-.4 4.4a.9.9 0 0 1-1.8 0l-.4-4.4A1.3 1.3 0 0 1 12 9.5z M12 17.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z</StreamGeometry>

  <!-- Check dentro de círculo (check calado). -->
  <StreamGeometry x:Key="Icon.CheckCircle">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M10.2 15.4l-3.1-3.1 1.4-1.4 1.7 1.7 4.3-4.3 1.4 1.4-5.7 5.7z</StreamGeometry>

  <!-- Punto (estado). -->
  <StreamGeometry x:Key="Icon.Dot">M12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z</StreamGeometry>

  <!-- Tienda: toldo + cuerpo con puerta. -->
  <StreamGeometry x:Key="Icon.Store">M3 4h18v3H3z M4 8h16v12h-5.5v-6H9.5v6H4V8z</StreamGeometry>

  <!-- Documento con líneas caladas. -->
  <StreamGeometry x:Key="Icon.Document">M6 2h9l5 5v15H6V2z M8.5 12h7v1.5h-7z M8.5 15h7v1.5h-7z M8.5 18h4.5v1.5h-4.5z</StreamGeometry>

  <!-- Guardar: disquete con obturador y etiqueta calados. -->
  <StreamGeometry x:Key="Icon.Save">M5 3h12l4 4v14H5V3z M8 3h7v7H8z M8 13h8v8H8z</StreamGeometry>

  <!-- Editar: lápiz. -->
  <StreamGeometry x:Key="Icon.Edit">M3 17.2V21h3.8L18 9.8 14.2 6 3 17.2z M14.9 4.3l2.1-2.1c.4-.4 1-.4 1.4 0l3.4 3.4c.4.4.4 1 0 1.4l-2.1 2.1-4.8-4.8z</StreamGeometry>

  <!-- Quitar: papelera con ranuras caladas. -->
  <StreamGeometry x:Key="Icon.Trash">M9 3h6v2h4v2H5V5h4V3z M6 8h12v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V8z M9 10v8h2v-8H9z M13 10v8h2v-8h-2z</StreamGeometry>

</ResourceDictionary>
