<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orvita.Print.Gui.ViewModels"
        xmlns:v="using:Orvita.Print.Gui.Views"
        x:Class="Orvita.Print.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Orvita Print"
        Width="960" Height="660"
        MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

  <!-- El icono del ejecutable/ventana se añade en GUI-07 (build genera el .ico). Sin
       recursos externos en XAML: todo el texto está aquí en español. -->

  <DockPanel Margin="8">
    <!-- Barra de estado (Doc/08 §4.6): una sola línea con el estado derivado de status. -->
    <Border DockPanel.Dock="Bottom" Padding="8,5" CornerRadius="4" Background="#F5F5F5">
      <TextBlock x:Name="StatusBar" Text="{Binding StatusBarText}" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Border>

    <TabControl x:Name="Tabs">
      <TabItem Header="Cola">
        <v:QueueView DataContext="{Binding Queue}" />
      </TabItem>
      <TabItem Header="Salidas">
        <v:DestinationsView DataContext="{Binding Destinations}" />
      </TabItem>
      <TabItem Header="Emparejamiento">
        <v:PairingView DataContext="{Binding Pairing}" />
      </TabItem>
      <TabItem Header="Diagnóstico">
        <v:DiagnosticsView DataContext="{Binding Diagnostics}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
