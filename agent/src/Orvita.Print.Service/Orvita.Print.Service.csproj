<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Servicio Windows headless de Orvita Print (ADR-09/13): worker + UseWindowsService, cola local, renderizado, impresión y heartbeat. Gestionado por CLI sobre named pipe (F2-08).</Description>
    <!-- net10.0-windows: referencia a Printing.Windows (ADR-12) y por tanto solo Windows en V1. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Orvita.Print.Service</RootNamespace>
    <!-- El ejecutable del servicio y las pruebas de humo lo referencian por nombre -->
    <AssemblyName>Orvita.Print.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <!-- DPAPI del token (S-01): ProtectedData, ámbito LocalMachine. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orvita.Print.Contracts\Orvita.Print.Contracts.csproj" />
    <ProjectReference Include="..\Orvita.Print.Core\Orvita.Print.Core.csproj" />
    <ProjectReference Include="..\Orvita.Print.Printing.Windows\Orvita.Print.Printing.Windows.csproj" />
  </ItemGroup>

</Project>
